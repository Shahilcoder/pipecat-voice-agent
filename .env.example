# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_API_KEY=change-me                 # clients send this in the X-API-Key header
SERVER_LOG_LEVEL=INFO
SERVER_MAX_CONCURRENT_SESSIONS=10
SERVER_BOT_IDLE_TIMEOUT_SECS=300

# --- LiveKit Cloud ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Azure Speech (STT) ---
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_LANGUAGE=en-US

# --- ElevenLabs (TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5       # low-latency model, a good default for voice agents

# --- LLM (model garden, OpenAI-compatible) ---
LLM_BASE_URL=https://your-model-garden.example.com/v1
LLM_API_KEY=
LLM_MODEL=your-model-name
